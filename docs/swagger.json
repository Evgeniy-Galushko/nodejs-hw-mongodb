    "/auth/get-oauth-url": {
      "get": {
        "tags": [
          "User"
        ],
        "summary": "Adding a new user",
        "operationId": "createGoogleUser",
        "description": "Adding a new user",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "email",
                  "password"
                ],
                "properties": {
                  "name": {
                    "description": "user name",
                    "type": "string",
                    "example": "John Wick"
                  },
                  "email": {
                    "description": "user email",
                    "example": "johnWick@gmail.com",
                    "type": "string"
